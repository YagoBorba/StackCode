{
  "name": "@stackcode/i18n",
  "version": "1.0.4",
  "description": "Internationalization (i18n) package for StackCode.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc && mkdir -p dist/locales && cp src/locales/*.json dist/locales/",
    "test": "echo \"✅ No tests for this package\""
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translations"
  ],
  "author": "Yago Borba",
  "license": "MIT",
  "homepage": "https://github.com/YagoBorba/StackCode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/YagoBorba/StackCode.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/YagoBorba/StackCode/issues"
  },
  "dependencies": {
    "configstore": "^7.0.0",
    "write-file-atomic": "^3.0.3"
  }
}
